{
  "name": "autonomous-inflation-hedge-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous wARS to USDT inflation hedge agent on Celo Mainnet.",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm --prefix frontend install --no-audit --no-fund && npm --prefix frontend run build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "register:identity": "tsx src/register-identity.ts",
    "clean": "rm -rf dist frontend/dist"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
