# Server runtime
PORT=3000
NODE_ENV=development

# Celo Mainnet agent wallet. Never commit the real private key.
AGENT_PRIVATE_KEY=0xyour_private_key
AGENT_WALLET_ADDRESS=0xYourAgentWalletAddress

# Textile FX credential. Keep this server-side only.
TEXTILE_API_KEY=your_textile_api_key
TEXTILE_API_BASE_URL=https://api.textilecredit.com/v2

# Optional execution controls
INFLATION_HEDGE_THRESHOLD=5
HEDGE_SELL_AMOUNT=1
DRY_RUN=true

# Optional frontend build-time public override. No private values belong here.
VITE_AGENT_WALLET_ADDRESS=0xYourAgentWalletAddress
VITE_API_BASE_URL=
